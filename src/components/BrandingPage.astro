---
import Bolt from "./Bolt.astro";
import { getContent, DEFAULT_LANG, path } from "../i18n/index.js";

const { lang = DEFAULT_LANG } = Astro.props;
const c = getContent(lang);
const b = c.branding;

const palette = [
  { name: "Blue", hex: "#5B8DFF", note: lang === "en" ? 'The "<SCI" letters' : "標誌的「<SCI」字母" },
  { name: "Sky", hex: "#58B3F5", note: lang === "en" ? "Spectrum midpoint" : "光譜中段" },
  { name: "Teal", hex: "#2AD6C0", note: lang === "en" ? "Spectrum midpoint" : "光譜中段" },
  { name: "Green", hex: "#3FDC9C", note: lang === "en" ? 'The "T>" letters' : "標誌的「T>」字母" },
  { name: "Bolt Gold", hex: "#F6C445", note: lang === "en" ? "The bolt. The only warm colour." : "那道閃電。唯一的暖色。" },
  { name: "Black", hex: "#000000", note: lang === "en" ? "Page background" : "頁面底色" },
];

const surfaces = [
  { key: "dark", label: b.surfaces.dark, bg: "#000000" },
  { key: "light", label: b.surfaces.light, bg: "#ffffff" },
  { key: "brand", label: b.surfaces.brand, bg: "#1b3fc8" },
];
---

<section class="page-head accent-gold">
  <div class="shell">
    <a class="link back" href={path(lang, "/")}>
      <span class="chev">←</span> {c.ui.back}
    </a>
    <h1 class="title">
      <Bolt size={28} class="title-bolt" />
      {b.title}
    </h1>
    <p class="lede title-lede">{b.lede}</p>
  </div>
</section>
<section class="section accent-blue" id="logo">
  <div class="shell">
    <div class="section-head">
      <span class="bracket">{b.logoHead.en}</span>
      <h2 class="h2">{b.logoHead.title}</h2>
      <p class="lede">{b.logoNote}</p>
    </div>

    <div class="logos stagger">
      {
        b.logos.map((logo, i) => (
          <article class="logo card card-topline rise" style={`--i:${i}`}>
            <div class="stage" style={`background:${surfaces[0].bg}`}>
              <img src={logo.file} alt={`SCINT ${logo.label}`} loading="lazy" />
            </div>
            <div class="logo-meta">
              <h3 class="h4">{logo.label}</h3>
              <p class="dim logo-note">{logo.note}</p>
              <a class="link" href={logo.file} download>
                {b.download} <span class="chev">↓</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <div class="contrast">
      <p class="faint contrast-label">{b.surfaceLabel}</p>
      <ul>
        {
          surfaces.map((surface) => (
            <li>
              <div class="contrast-swatch" style={`background:${surface.bg}`}>
                <img src="/assets/logo.png" alt={`SCINT — ${surface.label}`} loading="lazy" />
              </div>
              <p class="dim contrast-name">{surface.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
<section class="section section-soft accent-teal" id="palette">
  <div class="shell">
    <div class="section-head">
      <span class="bracket">{b.paletteHead.en}</span>
      <h2 class="h2">{b.paletteHead.title}</h2>
      <p class="lede">{b.paletteNote}</p>
    </div>

    <ul class="swatches stagger">
      {
        palette.map((col, i) => (
          <li class="swatch card rise" style={`--i:${i}`}>
            <span class="swatch-color" style={`background:${col.hex}`} />
            <div class="swatch-meta">
              <h3 class="h4">{col.name}</h3>
              <p class="faint swatch-hex">{col.hex}</p>
              <p class="dim swatch-note">{col.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<section class="section accent-green" id="usage">
  <div class="shell">
    <div class="section-head">
      <span class="bracket">{b.usageHead.en}</span>
      <h2 class="h2">{b.usageHead.title}</h2>
    </div>

    <div class="usage">
      <article class="card usage-card rise">
        <h3 class="h3 usage-title">{b.writing}</h3>
        {b.writingBody.map((line) => <p class="dim usage-line">{line}</p>)}

        <div class="examples">
          {b.examples.ok.map((x) => <p class="ok">{x}</p>)}
          {b.examples.no.map((x) => <p class="no">{x}</p>)}
        </div>
      </article>

      <article class="card usage-card rise" style="--i:1">
        <h3 class="h3 usage-title">{b.dontHead}</h3>
        <ul class="donts">
          {b.donts.map((d) => <li>{d}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .page-head {
    padding-block: calc(var(--nav-space) + clamp(1.5rem, 4vw, 3rem))
      clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .back {
    font-size: 0.9rem;
  }

  .back:hover .chev {
    transform: translateX(-3px);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.35rem 0 1rem;
    font-size: clamp(2.35rem, 5vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 750;
  }

  .title-bolt {
    color: var(--gold);
  }

  .title-lede {
    max-width: 52ch;
  }

  
  .logos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .logo {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .logo:first-child {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }

  .stage {
    display: grid;
    place-items: center;
    padding: clamp(1.75rem, 4vw, 3rem) 1rem;
    border-radius: var(--r);
    border: 1px solid var(--line);
    margin-bottom: 1.15rem;
  }

  .logo:first-child .stage {
    margin-bottom: 0;
  }

  .stage img {
    max-height: 90px;
    width: auto;
  }

  .logo-note {
    margin: 0.4rem 0 1rem;
    font-size: 0.94rem;
  }

  
  .contrast {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .contrast-label {
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .contrast ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .contrast-swatch {
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem) 1rem;
    border-radius: var(--r);
    border: 1px solid var(--line);
  }

  .contrast-swatch img {
    max-height: 54px;
    width: auto;
  }

  .contrast-name {
    margin-top: 0.7rem;
    font-size: 0.88rem;
  }

  
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .swatch {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
  }

  .swatch-color {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: var(--r);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  .swatch-hex {
    font-family: var(--font-code);
    font-size: 0.8rem;
    margin-top: 0.15rem;
  }

  .swatch-note {
    margin-top: 0.3rem;
    font-size: 0.86rem;
  }

  
  .usage {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .usage-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .usage-title {
    margin-bottom: 1rem;
  }

  .usage-line {
    font-size: 0.97rem;
    max-width: 54ch;
  }

  .usage-line + .usage-line {
    margin-top: 0.7rem;
  }

  .examples {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .examples p {
    position: relative;
    padding: 0.65rem 0.9rem 0.65rem 2.3rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg-soft);
    font-size: 0.95rem;
  }

  .examples p::before {
    position: absolute;
    left: 0.9rem;
    font-weight: 700;
  }

  .ok::before {
    content: "✓";
    color: var(--green);
  }

  .no {
    color: var(--fg-3);
  }

  .no::before {
    content: "✕";
    color: var(--gold);
  }

  .donts {
    display: grid;
    gap: 0.75rem;
  }

  .donts li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 0.95rem;
    color: var(--fg-2);
  }

  .donts li::before {
    content: "✕";
    position: absolute;
    left: 0;
    color: var(--gold);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .logos {
      grid-template-columns: 1fr 1fr;
    }

    .logo:first-child {
      grid-template-columns: 1fr;
    }

    .usage {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .logos,
    .contrast ul {
      grid-template-columns: 1fr;
    }
  }
</style>
