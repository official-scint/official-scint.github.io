---
import Bolt from "../Bolt.astro";
import { ACCENTS } from "../../data/accents.js";

const { section, blocks, faq } = Astro.props;
---

<section class="band band-soft accent-sky" id="about">
  <div class="wrap wrap-solo">
    <span class="ghost ghost-solo ghost-parallax" aria-hidden="true">06</span>
    <span class="bracket">{section.en}</span>

    <h2 class="creed rise">{section.title}</h2>
    <p class="creed-lede rise" style="--i:1">{section.lede}</p>

    <div class="manifesto">
      {blocks.map((block, i) => (
        <section class={`para ${ACCENTS[i % ACCENTS.length]}`}>
          <p class="para-key">
            <Bolt size={11} />
            {block.key}
          </p>
          <div class="para-text">
            {block.body.map((line) => <p>{line}</p>)}
          </div>
        </section>
      ))}
    </div>

    <p class="minor faint">{section.faqTitle}</p>
    <dl class="qa">
      {faq.map((item) => (
        <div>
          <dt>{item.q}</dt>
          <dd class="dim">{item.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .creed {
    margin: 0.9rem 0 1.25rem;
    font-size: clamp(1.9rem, 4.4vw, 3.6rem);
    line-height: 1.15;
    font-weight: 800;
    max-width: 24ch;
  }

  .creed-lede {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: 58ch;
    color: var(--fg-2);
  }

  .manifesto {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 62rem;
  }

  .para {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .para-key {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .para-text p {
    color: var(--fg-2);
  }

  .para-text p + p {
    margin-top: 0.6rem;
  }

  .qa > div {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1rem, 3vw, 2.25rem);
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .qa > div:first-child {
    border-top: 1px solid var(--line);
  }

  .qa dd {
    margin: 0;
  }

  @media (max-width: 640px) {
    .para,
    .qa > div {
      grid-template-columns: 1fr;
    }
  }
</style>
