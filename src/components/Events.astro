---
import { links } from "../data/site.js";
import { getContent, DEFAULT_LANG } from "../i18n/index.js";

const { lang = DEFAULT_LANG } = Astro.props;
const c = getContent(lang);

const strings = {
  empty: c.ui.empty,
  failed: c.ui.failed,
  goDiscord: c.ui.goDiscord,
  addCalendar: c.ui.addCalendar,
  today: c.ui.today,
  tomorrow: c.ui.tomorrow,
  past: c.ui.past,
  tba: c.ui.tba,
  isZh: lang !== "en",
  fallbackName: lang === "en" ? "SCINT event" : "SCINT 活動",
};
---

<div class="events" data-events aria-live="polite" aria-busy="true">
  <p class="state">
    <span class="spinner" aria-hidden="true"></span>{c.ui.loading}…
  </p>
</div>

<template data-event-template>
  <article class="event">
    <div class="when">
      <time class="when-day" data-date></time>
      <span class="when-time faint" data-time></span>
    </div>
    <div class="what">
      <span class="chip chip-brand count" data-countdown></span>
      <h3 class="h4 title" data-title></h3>
      <p class="dim desc" data-desc></p>
      <a class="link cal" data-calendar target="_blank" rel="noopener noreferrer"></a>
    </div>
    <img class="cover" data-cover alt="" hidden />
  </article>
</template>

<style>
  .events {
    display: grid;
  }

  .state {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
  }

  .spinner {
    width: 15px;
    height: 15px;
    border: 2px solid var(--line-strong);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  
  @keyframes eventIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .event {
    animation: eventIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 70ms);
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
    padding-block: clamp(1.15rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--line);
  }

  .event:last-child {
    border-bottom: 1px solid var(--line);
  }

  .when {
    text-align: left;
  }

  .when-day {
    display: block;
    font-size: 1.45rem;
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .when-time {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.76rem;
  }

  .count {
    margin-bottom: 0.5rem;
  }

  .title {
    margin-bottom: 0.35rem;
  }

  .desc {
    font-size: 0.95rem;
    white-space: pre-line;
    max-width: 58ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cal {
    margin-top: 0.7rem;
  }

  .cover {
    width: clamp(120px, 15vw, 176px);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r);
    border: 1px solid var(--line);
  }

  @media (max-width: 800px) {
    .event {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      align-items: start;
    }

    .cover {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>

<script define:vars={{ apiUrl: links.eventsApi, discord: links.discord, s: strings }}>
  const mount = document.querySelector("[data-events]");
  const template = document.querySelector("[data-event-template]");

  const pad = (n) => String(n).padStart(2, "0");

  const state = (text) => {
    mount.replaceChildren();
    const p = document.createElement("p");
    p.className = "state";
    p.append(`${text} `);

    const a = document.createElement("a");
    a.className = "link";
    a.href = discord;
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    a.textContent = `${s.goDiscord} →`;
    p.appendChild(a);

    mount.appendChild(p);
  };

  const calendarUrl = (event, start) => {
    const stamp = (d) => d.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");
    const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);
    const params = new URLSearchParams({
      action: "TEMPLATE",
      text: event.name ?? s.fallbackName,
      dates: `${stamp(start)}/${stamp(end)}`,
      details: event.description ?? "",
      sf: "true",
      output: "xml",
    });
    return `https://www.google.com/calendar/render?${params}`;
  };

  const countdown = (start) => {
    const days = Math.ceil((start - Date.now()) / 86400000);
    if (days < 0) return s.past;
    if (days === 0) return s.today;
    if (days === 1) return s.tomorrow;
    return s.isZh ? `還有 ${days} 天` : `In ${days} days`;
  };

  const render = (event) => {
    const node = template.content.firstElementChild.cloneNode(true);
    const start = new Date(event.scheduled_start_time);
    const valid = !Number.isNaN(start.getTime());

    node.querySelector("[data-title]").textContent = event.name ?? s.fallbackName;

    const desc = node.querySelector("[data-desc]");
    if (event.description) desc.textContent = event.description;
    else desc.remove();

    const dateEl = node.querySelector("[data-date]");
    const timeEl = node.querySelector("[data-time]");
    const countEl = node.querySelector("[data-countdown]");
    const cal = node.querySelector("[data-calendar]");

    if (valid) {
      dateEl.dateTime = start.toISOString();
      dateEl.textContent = `${pad(start.getMonth() + 1)}/${pad(start.getDate())}`;
      timeEl.textContent = `${pad(start.getHours())}:${pad(start.getMinutes())}`;
      countEl.textContent = countdown(start);
      cal.href = calendarUrl(event, start);
      cal.textContent = `${s.addCalendar} →`;
    } else {
      dateEl.textContent = "—";
      timeEl.textContent = s.tba;
      countEl.remove();
      cal.remove();
    }

    const cover = node.querySelector("[data-cover]");
    if (event.id && event.image) {
      cover.src = `https://cdn.discordapp.com/guild-events/${event.id}/${event.image}?size=1024`;
      cover.alt = event.name ?? "";
      cover.hidden = false;
    } else {
      cover.remove();
    }

    return node;
  };

  (async () => {
    try {
      const res = await fetch(apiUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const events = await res.json();

      if (!Array.isArray(events) || events.length === 0) {
        state(s.empty);
        return;
      }

      events.sort(
        (a, b) =>
          new Date(a.scheduled_start_time ?? 0) - new Date(b.scheduled_start_time ?? 0)
      );
      const nodes = events.map(render);
      nodes.forEach((node, i) => node.style.setProperty("--i", String(i)));
      mount.replaceChildren(...nodes);
    } catch (error) {
      console.warn("[events]", error);
      state(s.failed);
    } finally {
      mount.setAttribute("aria-busy", "false");
    }
  })();
</script>
