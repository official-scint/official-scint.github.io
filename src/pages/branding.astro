import BrandingPage from "../components/BrandingPage.astro";
import { getContent } from "../i18n/index.js";

const c = getContent("zh");
---

<Base
  lang="zh"
  title={c.meta.brandingTitle}
  description={c.meta.brandingDescription}
  ogDescription={c.meta.brandingDescription}
>
  <BrandingPage lang="zh" />
</Base>
